# --- Identifiants DHgate Open Platform ---------------------------------------
# Obtenus après inscription + approbation de ton app sur le portail développeur
# DHgate. Copie ce fichier vers `.env` et remplis les valeurs. NE COMMITE PAS .env.

DHGATE_APP_KEY=
DHGATE_SECRET_KEY=
# Jeton d'accès OAuth (si requis par les méthodes de ton périmètre).
DHGATE_ACCESS_TOKEN=

# --- À CONFIRMER dans ton dashboard développeur (varie selon l'app) -----------
# URL exacte de la passerelle API :
DHGATE_GATEWAY_URL=https://openapi.dhgate.com/router/api
# Nom de la méthode de recherche produits accordée à ton app :
DHGATE_SEARCH_METHOD=dh.product.search
DHGATE_API_VERSION=2.0
# Méthode de signature : "md5" (secret encadrant) ou "hmac" (hmac-md5).
DHGATE_SIGN_METHOD=md5

# --- Conversion d'affichage --------------------------------------------------
# Taux USD -> XAF utilisé pour afficher un prix indicatif en francs CFA.
USD_TO_XAF_RATE=600
